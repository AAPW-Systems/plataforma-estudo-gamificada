# Copie para .env (ignorado pelo git) e preencha as credenciais locais.
# Nenhum valor secreto fica neste arquivo (regra 9). Tabela de referência:
# docs/specs/001-conta-acesso/plan.md, "Variáveis de ambiente".

# Ambiente: desenvolvimento | teste | producao. Swagger UI só em desenvolvimento.
APP_AMBIENTE=desenvolvimento

# Banco local (serviço db). POSTGRES_PASSWORD: qualquer senha local, obrigatória.
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=
POSTGRES_DB=plataforma

# Segredo da aplicação: HMAC do CSRF e da chave das tentativas. Mínimo de 32 bytes aleatórios.
# Gere com: docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_APLICACAO=

# Origens aceitas no cabeçalho Origin das requisições que alteram estado (separadas por vírgula).
ORIGENS_PERMITIDAS=http://localhost:5173

# Endereços ou redes cujo X-Forwarded-For é aceito (o proxy do Vite no Compose).
PROXIES_CONFIAVEIS=172.28.0.10

# Nomes dos cookies. Se o navegador não aceitar o prefixo __Host- em http://localhost,
# use sessao e csrf (quickstart da 001, "Falhas conhecidas"). Em produção o prefixo é obrigatório.
COOKIE_SESSAO_NOME=__Host-sessao
COOKIE_CSRF_NOME=__Host-csrf

# Sessão (RF-006, D-006): dias sem uso e duração máxima.
SESSAO_DIAS_INATIVIDADE=14
SESSAO_DIAS_MAXIMO=30

# Limites de tentativas (RQ-003).
LIMITE_FALHAS_CONTA=5
LIMITE_FALHAS_IP=20
JANELA_TENTATIVAS_MIN=15
BLOQUEIO_MIN=15
LIMITE_CADASTROS_IP_HORA=10

# Cálculos simultâneos do Argon2id (64 MiB cada; DTEC 023).
ARGON2_CONCORRENCIA=4

# Armazenamento de arquivos (DTEC 010): local (disco) no MVP.
ARMAZENAMENTO_ADAPTADOR=local
ARMAZENAMENTO_DIRETORIO=/dados/arquivos

# Acervo (spec 002, RQ-005). Os mesmos limites chegam à interface por GET /api/v1/acervo/uso.
# Tamanho máximo de uma fonte (2 MiB) e de páginas de um PDF.
FONTE_TAMANHO_MAX_BYTES=2097152
PDF_MAX_PAGINAS=500
# Cotas por estudante: matérias, fontes por matéria e armazenamento total (100 MiB).
COTA_MATERIAS=50
COTA_FONTES_POR_MATERIA=30
COTA_ARMAZENAMENTO_BYTES=104857600
# Divisão em trechos (DTEC 029): a sobreposição precisa ser menor que o alvo, e o alvo, no máximo o máximo.
TRECHO_TAMANHO_ALVO=1200
TRECHO_TAMANHO_MAXIMO=2000
TRECHO_SOBREPOSICAO=150
# Subprocessos que abrem arquivos não confiáveis (DTEC 024): validação na API e extração no worker.
VALIDACAO_ARQUIVO_TEMPO_S=10
VALIDACAO_ARQUIVO_MEMORIA_MB=256
VALIDACAO_ARQUIVO_CONCORRENCIA=2
EXTRACAO_TEMPO_S=30
EXTRACAO_MEMORIA_MB=512
# Reconciliação de objetos órfãos (DTEC 025) e jobs travados (DTEC 030).
RECONCILIACAO_MARGEM_MIN=60
FILA_SEGUNDOS_TRAVADO=60

# Nível dos logs: DEBUG | INFO | WARNING | ERROR.
LOG_NIVEL=INFO
