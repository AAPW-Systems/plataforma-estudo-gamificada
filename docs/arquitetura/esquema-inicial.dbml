// Esquema inicial do banco (QA-21)
// Atualizado em 12/10/2026. Registros: docs/prompts/2026-10-12-esquema-inicial-banco.md e
// docs/prompts/2026-10-12-001-conta-acesso-plano.md (tentativas_acesso; nome com até 100 caracteres)
// e docs/prompts/2026-10-13-002-materias-fontes-plano.md (fontes: codigo_falha no lugar de
// motivo_falha, versao_extracao, total_trechos, título com até 120 caracteres e conteúdo único
// por matéria) e docs/prompts/2026-10-13-003-cartoes-manuais-plano.md (cartoes: referência da fonte
// com cópia da origem, entrada_estudo_em no lugar de aceito_em, índice da listagem; fontes: alvo da
// FK composta da referência) e docs/prompts/2026-10-13-004-geracao-cartoes-plano.md (geracoes:
// codigo_falha no lugar de motivo_falha, FK composta para a fonte, uma em andamento por fonte;
// geracoes_trechos, cartoes_descartados e ciencias_aviso_ia; cartoes: motivo_recusa; evidencias:
// deslocamentos da citação) e docs/prompts/2026-10-13-005-licao-trilha-plano.md (licoes: numero na
// conclusão, encerrada_em, uma aberta por estudante; licoes_cartoes e apresentacoes; revisoes:
// apresentação, semente do fuzz, primeira do dia, tornou dominado, versão das regras; FKs
// compostas com o dono)
// Visualização: cole este arquivo em https://dbdiagram.io
//
// Este esquema é o ponto de partida do data-model.md de cada spec. A spec aprovada
// prevalece: mudanças de comportamento atualizam a spec primeiro e depois este arquivo.

Project plataforma_estudo_gamificada {
  database_type: 'PostgreSQL'
  Note: '''
  **Convenções**

  - Tabelas no plural, snake_case, em português e sem acentos.
  - Chave primária: `bigint generated always as identity` (PostgreSQL 10+), escrita aqui como
    `bigint [pk, increment]`. A exportação SQL do dbdiagram gera `by default`; as migrações
    (Alembic) usam `always`. Ela nunca sai da API. Uma `pk` já implica `not null` e `unique`;
    nada é repetido.
  - `public_id uuid` v4 (`gen_random_uuid()`) só nas tabelas cujos recursos aparecem em rotas.
    É o único identificador exposto, o que impede a enumeração de registros. Tabelas internas
    não têm `public_id`.
  - Instantes em `timestamptz` (UTC). Dias de estudo em `date`, já no fuso do estudante, com
    virada às 4h (RN-15).
  - Arquivos (fontes e imagens) ficam atrás de uma interface de armazenamento (DTEC 010): disco
    local no MVP, Cloudflare R2 no final acadêmico. O banco guarda a **chave do objeto**, igual
    nos dois, nunca a URL ou o caminho absoluto.
  - Exclusão física (RN-14). FKs para tabelas com objetos no R2 usam `restrict`: a aplicação
    exclui os objetos e depois as linhas, na ordem certa.
  - O FSRS é soberano (DTEC 012): os campos de estado do cartão espelham o `Card` da
    biblioteca `fsrs`, e nenhuma regra do produto altera o agendamento que ele calcula.
  - As tabelas da fila (Procrastinate) são criadas pela própria biblioteca e não aparecem aqui.
  - Extensões: `unaccent` desde a spec 003 (busca dos cartões, DTEC 033); `vector` no final
    acadêmico (DTEC 005).
  - Cada spec cria só as tabelas, colunas e valores de enum que usa. As notas indicam a spec que
    cria cada coluna quando ela não nasce com a tabela.
  '''
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum papel_usuario {
  estudante
  admin [note: 'Usa o painel administrativo do final acadêmico (F-17)']
}

Enum estado_fonte {
  pendente
  processando
  concluido
  falhou
}

Enum codigo_falha_fonte {
  falha_tecnica [note: 'Erro de infraestrutura depois das novas tentativas automáticas; o estudante pode pedir nova tentativa']
  sem_texto [note: 'PDF sem camada de texto ou arquivo sem texto extraível (CB-23); sem nova tentativa']
  conteudo_invalido [note: 'Arquivo que não pôde ser lido dentro dos limites de tempo e memória (DTEC 024); sem nova tentativa']
}

Enum estado_geracao {
  pendente
  processando
  concluida [note: 'Inclui a geração com 0 cartões sustentados (US4-6 da 004)']
  falhou [note: 'Só falha técnica ou fonte excluída; não conta no limite diário (D-010 da 004)']
}

Enum codigo_falha_geracao {
  provedor_indisponivel [note: 'Timeout, conexão ou 5xx depois das novas tentativas']
  limite_provedor [note: 'Cota do provedor esgotada (CB-14)']
  resposta_invalida [note: 'Saída fora do esquema depois da correção pedida ao modelo']
  orcamento_esgotado [note: 'Orçamento diário de tokens do estudante (DTEC 040)']
  fonte_excluida [note: 'Fonte excluída durante a geração (CB-16)']
}

Enum motivo_recusa {
  incorreto
  irrelevante
  repetido
  mal_escrito
}

Enum motivo_descarte {
  estrutura_invalida [note: 'Campo ausente ou fora dos limites (RF-006)']
  sem_evidencia [note: 'Trecho citado inexistente na janela enviada']
  citacao_nao_encontrada [note: 'Citação não é literal no trecho citado']
  cobertura_insuficiente [note: 'Verso ou explicação sem apoio lexical no trecho']
  reprovado_verificador [note: 'Reprovado pela juíza (só reprova, nunca aprova sozinha)']
  repetido [note: 'Repete um cartão da matéria (RF-013)']
  excedente [note: 'Além dos 10 primeiros aprovados']
}

Enum origem_cartao {
  gerado_verificado [note: 'Gerado pela IA e sustentado por trechos']
  editado [note: 'Gerado e depois editado pelo estudante; perde o selo de verificado']
  criado [note: 'Criado manualmente pelo estudante']
}

Enum situacao_cartao {
  aguardando_revisao [note: 'Gerado, ainda não aceito; fora das lições. Acrescentado pela spec 004']
  ativo [note: 'Criado pela spec 003']
  suspenso [note: 'Fora das lições; estado do FSRS preservado. Criado pela spec 003']
  recusado [note: 'Invisível ao estudante; conta para a taxa de aceitação e para "Gerar mais". Acrescentado pela spec 004']
}

Enum estado_fsrs {
  aprendizado [note: 'State.Learning. Um cartão novo é "aprendizado" com ultima_revisao nula']
  revisao [note: 'State.Review']
  reaprendizado [note: 'State.Relearning']
}

Enum nota_revisao {
  errei [note: 'Rating.Again (1)']
  dificil [note: 'Rating.Hard (2)']
  bom [note: 'Rating.Good (3)']
  facil [note: 'Rating.Easy (4)']
}

Enum origem_parametros_fsrs {
  padrao [note: 'Pesos padrão da biblioteca']
  otimizado [note: 'Pesos calculados pelo otimizador com o histórico do estudante (fora do MVP)']
}

Enum tipo_evento_xp {
  revisao [note: 'Primeira revisão do cartão no dia, independentemente da nota (RN-18)']
  cartao_dominado [note: 'Bônus único quando o cartão é dominado pela primeira vez']
}

Enum situacao_dia {
  pendente [note: 'Dia corrente (ou repetido) com revisões e meta efetiva ainda não atingida']
  estudado [note: 'Meta efetiva atingida com pelo menos uma revisão; definitivo (RF-006)']
  nao_estudado [note: 'Dia liquidado com cartões disponíveis e meta não cumprida; zera a sequência']
  neutro [note: 'Dia liquidado sem revisões e sem cartão disponível na virada, ou data pulada pela mudança de fuso (RF-007, D-003)']
}

Enum tipo_tentativa_acesso {
  falha_entrada
  falha_senha_atual [note: 'Senha atual errada na troca de senha ou na exclusão da conta']
  cadastro
}

Enum papel_mensagem {
  estudante
  assistente
}

// ---------------------------------------------------------------------------
// MVP
// ---------------------------------------------------------------------------

TableGroup identidade [color: #3B82F6] {
  usuarios
  sessoes
  tentativas_acesso
}

TableGroup acervo [color: #10B981] {
  materias
  fontes
  trechos
}

TableGroup cartoes_e_ia [color: #F59E0B] {
  geracoes
  geracoes_trechos
  cartoes
  evidencias_cartoes
  cartoes_descartados
  consumo_ia
  ciencias_aviso_ia
}

TableGroup revisao_fsrs [color: #8B5CF6] {
  parametros_fsrs
  licoes
  licoes_cartoes
  apresentacoes
  revisoes
}

TableGroup gamificacao [color: #EF4444] {
  eventos_xp
  dias_estudo
}

Table usuarios {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  nome varchar(100) [not null, note: '1 a 100 caracteres, sem espaços nas extremidades (RF-001 da spec 001)']
  email varchar(254) [not null, note: 'Único sem diferenciar maiúsculas (índice em lower(email))']
  senha_hash varchar(255) [not null, note: 'Argon2id (DTEC 003)']
  papel papel_usuario [not null, default: 'estudante']
  fuso varchar(64) [not null, default: 'America/Sao_Paulo', note: 'Nome IANA (RN-15)']
  meta_diaria smallint [not null, note: 'Cartões distintos por dia (RN-21); de 1 a 200, padrão 20 (D-001 da 001)']
  tamanho_licao smallint [not null, note: 'Cartões distintos por lição (RN-19); padrão em QA-24']
  limite_novos_dia smallint [not null, note: 'Cartões novos por dia (RN-20); padrão em QA-24']
  xp_total integer [not null, default: 0, note: 'Cache de sum(eventos_xp.quantidade), atualizado na mesma transação (spec 006, DTEC 059)']
  sequencia_atual integer [not null, default: 0, note: 'Sequência vigente na última liquidação ou marcação (spec 006, DTEC 061)']
  sequencia_recorde integer [not null, default: 0, note: 'Maior sequência atingida (RN-21); CHECK sequencia_recorde >= sequencia_atual']
  ultimo_dia_estudado date [note: 'Último dia em que a meta efetiva foi cumprida']
  dias_liquidados_ate date [note: 'Último dia de estudo já classificado; nulo antes da primeira liquidação (spec 006, DTEC 061)']
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]

  indexes {
    `lower(email)` [unique, name: 'usuarios_email_unico']
  }

  Note: 'Estudantes e administradores compartilham a tabela e o login. As preferências do FSRS (retenção desejada) ficam em parametros_fsrs.'
}

Table sessoes {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  token_hash bytea [not null, unique, note: 'SHA-256 do identificador opaco do cookie; o identificador em si nunca é gravado']
  criada_em timestamptz [not null, default: `now()`]
  ultimo_uso_em timestamptz [not null, default: `now()`]
  expira_em timestamptz [not null]
  revogada_em timestamptz [note: 'Logout ou revogação; sessão revogada nunca volta a valer']
  ip inet
  agente_usuario varchar(512)

  indexes {
    usuario_id
  }

  Note: 'Sessão opaca em cookie HttpOnly (DTEC 003).'
}

Table tentativas_acesso {
  id bigint [pk, increment]
  tipo tipo_tentativa_acesso [not null]
  chave_conta bytea [note: 'HMAC-SHA-256 do e-mail normalizado; nula em cadastro. Vale também para e-mails sem conta (CS-003)']
  ip inet [not null]
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    (chave_conta, criado_em)
    (ip, tipo, criado_em)
  }

  Note: 'Limites de tentativas da RQ-003 da spec 001 (DTEC 020). Sem FK nem e-mail em claro; linhas com mais de 24 horas são apagadas por tarefa periódica.'
}

Table materias {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  nome varchar(60) [not null, note: '1 a 60 caracteres (RN-23)']
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, `lower(nome)`) [unique, name: 'materias_nome_unico_por_usuario']
    (id, usuario_id) [unique, name: 'materias_id_usuario', note: 'Alvo das FKs compostas que garantem que fonte e cartão pertencem ao dono da matéria (RN-01)']
  }
}

Table fontes {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  materia_id bigint [not null]
  titulo varchar(120) [not null, note: '1 a 120 caracteres; renomeável (D-005 da 002)']
  nome_arquivo varchar(255) [not null, note: 'Nome enviado, sem caminho e sem caracteres de controle; só exibido, nunca usado como caminho']
  chave_objeto varchar(512) [not null, unique, note: 'usuarios/{public_id_usuario}/fontes/{uuid} (DTEC 021); igual no disco local e no R2']
  tipo_midia varchar(100) [not null, note: 'Tipo real detectado pelo conteúdo (RN-02)']
  tamanho_bytes integer [not null]
  hash_sha256 bytea [not null, note: 'Integridade do arquivo e recusa de conteúdo idêntico na mesma matéria (D-004 da 002)']
  estado estado_fonte [not null, default: 'pendente']
  codigo_falha codigo_falha_fonte [note: 'Preenchido somente quando estado = falhou; a mensagem ao estudante vem do catálogo da aplicação (DTEC 030)']
  total_paginas integer [note: 'Só quando conhecido (PDF)']
  total_trechos integer [note: 'Gravado na mesma transação dos trechos; nulo antes de concluido']
  versao_extracao varchar(50) [note: 'Versão do extrator e dos parâmetros de divisão que geraram os trechos (DTEC 029)']
  processada_em timestamptz
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]

  indexes {
    (materia_id, usuario_id) [note: 'Cobre a FK composta e a listagem por matéria']
    (materia_id, hash_sha256) [unique, name: 'fontes_conteudo_unico_por_materia', note: 'D-004 da 002; resolve envios simultâneos do mesmo arquivo']
    usuario_id [note: 'Cota de armazenamento por estudante (D-003 da 002)']
    (id, materia_id, usuario_id) [unique, name: 'fontes_id_materia_usuario', note: 'Alvo da FK composta da referência do cartão manual: mesma matéria e mesmo dono (spec 003)']
  }

  Note: 'Estado e codigo_falha são coerentes: codigo_falha só existe em falhou (CHECK na migração).'
}

Table trechos {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`, note: 'Exposto na consulta da evidência (RF-17)']
  fonte_id bigint [not null]
  ordem integer [not null, note: 'Posição do trecho na fonte']
  texto text [not null]
  pagina integer [note: 'Somente quando conhecida; nunca inventada (RN-05)']
  inicio_caractere integer [not null, note: 'Deslocamento no texto normalizado da fonte inteira (DTEC 029)']
  fim_caractere integer [not null, note: 'Maior que inicio_caractere']
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    (fonte_id, ordem) [unique]
  }
}

Table geracoes {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  materia_id bigint [not null]
  fonte_id bigint [note: 'Nula quando a fonte foi excluída (ou, no final acadêmico, quando o pedido é da matéria inteira)']
  chave_idempotencia uuid [not null, note: 'Gerada no cliente (RN-10)']
  estado estado_geracao [not null, default: 'pendente']
  codigo_falha codigo_falha_geracao [note: 'Só quando estado = falhou; mensagem do catálogo da aplicação (DTEC 043)']
  provedor varchar(50) [note: 'Gravado ao iniciar']
  modelo varchar(100)
  versao_instrucoes varchar(50) [note: 'Ex.: gerador-v1+juiza-v1 (RQ-006 da 004)']
  quantidade_gerada integer [not null, default: 0, note: 'Saídas do modelo']
  quantidade_aprovada integer [not null, default: 0, note: 'Publicadas: aprovadas nas validações estrutural e de sustentação (RN-22)']
  pontos_contraditorios integer [not null, default: 0, note: 'Pontos contraditórios declarados pelo modelo; nunca viram cartão (CB-09)']
  criado_em timestamptz [not null, default: `now()`, note: 'Conta no limite diário pelo dia de estudo (D-005 da 004)']
  iniciada_em timestamptz
  concluida_em timestamptz

  indexes {
    (usuario_id, chave_idempotencia) [unique]
    (usuario_id, criado_em) [note: 'Limite diário de gerações (DTEC 044)']
    (materia_id, usuario_id)
    fonte_id [unique, name: 'geracoes_fonte_em_andamento', note: 'Parcial: WHERE estado IN (pendente, processando); uma geração em andamento por fonte']
  }

  Note: '''
  Pedido de geração de cartões (spec 004). Aceitos e recusados são contados em cartoes (taxa de aceitação, RN-22).
  FK composta (fonte_id, materia_id, usuario_id) -> fontes com ON DELETE SET NULL (fonte_id) (PostgreSQL 15+).
  CHECK: codigo_falha presente se e somente se estado = falhou.
  '''
}

Table geracoes_trechos {
  geracao_id bigint [not null]
  trecho_id bigint [not null]

  indexes {
    (geracao_id, trecho_id) [pk]
    trecho_id [note: 'Cobertura: trechos já enviados numa geração concluida (DTEC 041)']
  }

  Note: 'Janela de trechos enviada ao modelo em cada geração (RF-017 da 004). Spec 004.'
}

Table cartoes {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  materia_id bigint [not null]
  geracao_id bigint [note: 'Nula em cartões criados manualmente. Criada pela spec 004']
  motivo_recusa motivo_recusa [note: 'Opcional; só em situação recusado (D-007 da 004). Criada pela spec 004']
  frente text [not null, note: 'Pergunta']
  chave_imagem varchar(512) [note: 'Chave da imagem opcional da frente (final acadêmico, RF-27). Criada pela spec 011']
  verso text [not null, note: 'Resposta']
  explicacao text [note: 'Explicação curta exibida ao marcar Errei (RN-16). Opcional nos manuais, obrigatória nos gerados (validada na aplicação); nula quando vazia']
  origem origem_cartao [not null]
  situacao situacao_cartao [not null]
  entrada_estudo_em timestamptz [note: 'Entrada no estudo: criação (manual) ou aceitação (gerado; no Aceitar todos, instante + i microssegundos). Ordem dos novos nas lições (RN-20); presente se e somente se ativo ou suspenso']
  // Referência opcional de um cartão manual a uma fonte da matéria (spec 003, RF-002)
  fonte_id bigint [note: 'Fonte citada como referência; nula sem referência ou depois que a fonte é excluída ("Fonte apagada")']
  referencia_titulo varchar(120) [note: 'Cópia da descrição da origem (RN-05); sobrevive à exclusão e à renomeação da fonte']
  referencia_nome_arquivo varchar(255)
  referencia_enviada_em timestamptz
  // Estado do FSRS: espelha fsrs.Card
  estado_fsrs estado_fsrs [not null, default: 'aprendizado']
  passo smallint [note: 'Card.step: passo de aprendizado ou reaprendizado (0 no cartão novo); nulo em revisao']
  estabilidade "double precision" [note: 'Card.stability: nula até a primeira revisão']
  dificuldade "double precision" [note: 'Card.difficulty, de 1 a 10: nula até a primeira revisão']
  vencimento timestamptz [not null, default: `now()`, note: 'Card.due: instante UTC em que o cartão vence']
  ultima_revisao timestamptz [note: 'Card.last_review: nula = cartão novo']
  dominado_em timestamptz [note: 'Primeira vez que estabilidade >= limiar das regras versionadas (21 dias, D-003 da 005); nunca volta a nulo; garante bônus único. Criada pela spec 005']
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, situacao, vencimento) [name: 'cartoes_devidos', note: 'Monta a lição: cartões ativos com vencimento antes da próxima virada das 4h']
    (usuario_id, situacao, entrada_estudo_em) [name: 'cartoes_novos', note: 'Cartões novos na ordem de entrada no estudo']
    (materia_id, usuario_id, criado_em, id) [name: 'cartoes_materia', note: 'Cobre a FK composta e a listagem paginada por cursor da matéria (DTEC 034)']
    fonte_id [note: 'Impacto e marcação na exclusão da fonte (DTEC 027)']
    geracao_id [note: 'Criado pela spec 004']
    (id, usuario_id) [unique, name: 'cartoes_id_usuario', note: 'Alvo das FKs compostas de licoes_cartoes, apresentacoes e revisoes (DTEC 019). Criado pela spec 005']
  }

  Note: '''
  O deck do estudante é o conjunto dos seus cartões, filtrável por matéria; não há tabela de deck.
  Editar o conteúdo não altera o estado do FSRS (RN-26).
  CHECKs (spec 003): frente, verso e explicação dentro dos tetos absolutos (4.000, 8.000 e 4.000
  caracteres; os limites vigentes são configuráveis e menores, D-004); as três cópias da referência
  presentes juntas ou ausentes juntas; fonte_id só com as cópias; referência só com origem = criado;
  entrada_estudo_em presente se e somente se situação ativo ou suspenso; dificuldade de 1 a 10.
  CHECKs (spec 004): geracao_id nulo em origem criado; aguardando_revisao e recusado só com origem
  gerado_verificado; motivo_recusa só em recusado; explicação obrigatória em gerado_verificado.
  Selo de verificado e "Fonte apagada" dos gerados são derivados de geracoes.fonte_id (DTEC 045).
  Busca por frente e verso com lower(unaccent(...)) (DTEC 033).
  '''
}

Table evidencias_cartoes {
  id bigint [pk, increment]
  cartao_id bigint [not null]
  trecho_id bigint [note: 'Nulo depois que a fonte é excluída: o cartão exibe "fonte apagada"']
  fonte_titulo varchar(120) [not null, note: 'Cópia da descrição da origem (RN-05), sobrevive à exclusão da fonte']
  fonte_nome_arquivo varchar(255) [not null]
  fonte_enviada_em timestamptz [not null]
  pagina integer [note: 'Somente quando conhecida']
  citacao_inicio integer [not null, note: 'Deslocamento da citação literal no texto do trecho (DTEC 042); só para o destaque, sem copiar o texto (RN-05)']
  citacao_fim integer [not null, note: 'Maior que citacao_inicio']

  indexes {
    (cartao_id, trecho_id) [unique]
    trecho_id
  }

  Note: 'Spec 004. Ao menos uma evidência por cartão gerado (RF-006), inserida na mesma transação da publicação.'
}

Table cartoes_descartados {
  id bigint [pk, increment]
  geracao_id bigint [not null]
  usuario_id bigint [not null]
  motivo motivo_descarte [not null]
  detalhe varchar(100) [note: 'Código curto, ex.: motivo da juíza; nunca texto da fonte']
  frente text [note: 'Como veio do modelo; anulável quando ausente']
  verso text
  explicacao text
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    geracao_id
  }

  Note: 'Saída do modelo reprovada nas validações (RF-007 da 004). Nunca exposta em rotas; só análise. Apagada com a fonte, a matéria e a conta (DTEC 046).'
}

Table consumo_ia {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  geracao_id bigint
  operacao varchar(50) [not null, note: 'Ex.: gerar_cartoes; no final, responder_chat, embutir, reordenar']
  provedor varchar(50) [not null]
  modelo varchar(100) [not null]
  versao_instrucoes varchar(50)
  tokens_entrada integer
  tokens_saida integer
  latencia_ms integer [not null]
  custo_estimado numeric(12,6)
  sucesso boolean [not null]
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, criado_em) [note: 'Orçamento diário por estudante']
  }

  Note: 'Uma linha por chamada ao provedor (limites operacionais, DTEC 011 e 040), inclusive as que falharam. Nunca guarda conteúdo das fontes, perguntas ou respostas. Orçamento diário em tokens por dia de estudo. Spec 004.'
}

Table ciencias_aviso_ia {
  usuario_id bigint [not null]
  versao_aviso varchar(50) [not null, note: 'Versão do aviso do provedor configurado (ex.: gemini-v1)']
  confirmada_em timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, versao_aviso) [pk]
  }

  Note: 'Ciência do envio de trechos a um provedor de IA externo (RF-002 da 004, DTEC 039). Domínio ia.'
}

Table parametros_fsrs {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  versao integer [not null, note: 'A vigente é a maior versão do usuário']
  origem origem_parametros_fsrs [not null, default: 'padrao']
  pesos "float8[]" [not null, note: 'Os 21 pesos do modelo (Scheduler.parameters)']
  retencao_desejada numeric(3,2) [not null, default: 0.90, note: 'Preferência do perfil (RF-19)']
  passos_aprendizado_s "integer[]" [not null, note: 'Scheduler.learning_steps em segundos; padrão {60, 600}']
  passos_reaprendizado_s "integer[]" [not null, note: 'Scheduler.relearning_steps em segundos; padrão {600}']
  intervalo_maximo_dias integer [not null, default: 36500]
  fuzzing boolean [not null, default: true]
  versao_biblioteca varchar(20) [not null, note: 'Versão fixada da biblioteca fsrs']
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, versao) [unique]
  }

  Note: 'Imutável: mudar a retenção desejada ou otimizar os pesos cria uma nova versão. Cada revisão aponta a versão usada (reprodutibilidade, RN-17).'
}

Table licoes {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  numero integer [note: 'Posição do nó na trilha; atribuída só na conclusão (sem buracos pelas lições encerradas)']
  dia_estudo date [not null, note: 'Dia de estudo do início']
  extra boolean [not null, default: false, note: 'Já havia lição concluída no mesmo dia de estudo (RF-012)']
  tamanho_alvo smallint [not null, note: 'Cartões distintos previstos: usuarios.tamanho_licao no início']
  iniciada_em timestamptz [not null, default: `now()`]
  concluida_em timestamptz [note: 'Todos os previstos revisados ou retirados e nenhum passo curto vencido pendente (D-004); acende o nó']
  encerrada_em timestamptz [note: 'Encerrada sem acender o nó: aberta de um dia de estudo anterior (D-005)']

  indexes {
    (usuario_id, numero) [unique, name: 'licoes_numero', note: 'Parcial: where numero is not null; paginação da trilha']
    usuario_id [unique, name: 'licoes_uma_aberta', note: 'Parcial: where concluida_em is null and encerrada_em is null']
    (id, usuario_id) [unique, note: 'Alvo das FKs compostas']
  }

  Note: '''
  Sessão de estudo e nó da trilha (RN-19). Um cartão marcado Errei volta na mesma lição quando o
  passo curto do FSRS vence (spec 005, DTEC 054).
  CHECKs: concluida_em e encerrada_em nunca juntas; numero presente se e somente se concluida_em.
  '''
}

Table licoes_cartoes {
  licao_id bigint [pk]
  cartao_id bigint [pk]
  usuario_id bigint [not null]
  posicao smallint [not null, note: 'Ordem de montagem: devidos (vencimento mais antigo primeiro), depois novos (entrada_estudo_em)']
  novo boolean [not null, note: 'Sem revisão anterior na montagem; conta no limite só na primeira revisão (D-007)']
  revisado_em timestamptz [note: 'Primeira revisão nesta lição']
  retirado_em timestamptz [note: 'Saiu sem revisão: suspenso ou fora de ativo, ou limite de novos atingido']

  indexes {
    (licao_id, posicao) [unique]
  }

  Note: 'Cartões previstos da lição (spec 005, DTEC 049). Plano da sessão, não histórico: sai em cascata com o cartão (exceção registrada no plano da 005).'
}

Table apresentacoes {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  licao_id bigint [not null]
  cartao_id bigint [not null]
  revendo boolean [not null, note: 'Reapresentação por passo curto vencido (RF-006)']
  exibida_em timestamptz [not null, default: `now()`]
  revelada_em timestamptz [note: 'Primeiro pedido de revelação (RF-003)']
  avaliada_em timestamptz

  indexes {
    licao_id [unique, name: 'apresentacoes_uma_pendente', note: 'Parcial: where avaliada_em is null']
    cartao_id
  }

  Note: '''
  Cada exibição de um cartão na lição (spec 005, DTEC 052). O verso só sai depois de revelada_em;
  a avaliação exige revelada_em. CHECK: avaliada_em só com revelada_em.
  '''
}

Table revisoes {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  cartao_id bigint [note: 'Nulo se o cartão for excluído: a revisão nunca é apagada (RN-14)']
  licao_id bigint [not null]
  apresentacao_public_id uuid [not null, note: 'Apresentação avaliada; valor copiado, sem FK, para sobreviver à exclusão do cartão. Uma revisão por apresentação (CB-24)']
  parametros_fsrs_id bigint [not null]
  chave_idempotencia uuid [not null, note: 'Gerada no cliente (RN-10)']
  nota nota_revisao [not null]
  revisada_em timestamptz [not null, note: 'ReviewLog.review_datetime']
  duracao_ms integer [not null, note: 'Medida no cliente, da exibição da frente à nota (D-006), limitada pelo servidor (DTEC 052)']
  dia_estudo date [not null, note: 'Dia de estudo no fuso vigente no instante da revisão (CB-25)']
  semente_fuzz bigint [not null, note: 'Semente do fuzz desta revisão (CS-001, DTEC 053)']
  versao_regras smallint [not null, note: 'Versão das regras da revisão (limiar de dominado), DTEC 055']
  primeira_do_dia boolean [not null, note: 'Primeira revisão do cartão no dia de estudo; base do XP da 006 (RN-18)']
  tornou_dominado boolean [not null, note: 'Esta revisão preencheu cartoes.dominado_em; base do bônus da 006']
  // Estado do cartão antes da revisão
  estado_antes estado_fsrs [not null]
  passo_antes smallint
  estabilidade_antes "double precision"
  dificuldade_antes "double precision"
  vencimento_antes timestamptz [not null]
  ultima_revisao_antes timestamptz [note: 'Nula = primeira revisão do cartão (conta no limite de novos, D-007)']
  // Estado do cartão depois da revisão
  estado_depois estado_fsrs [not null]
  passo_depois smallint
  estabilidade_depois "double precision" [not null]
  dificuldade_depois "double precision" [not null]
  vencimento_depois timestamptz [not null]

  indexes {
    (usuario_id, chave_idempotencia) [unique]
    apresentacao_public_id [unique]
    (usuario_id, dia_estudo)
    (usuario_id, dia_estudo) [name: 'revisoes_novos_dia', note: 'Parcial: where ultima_revisao_antes is null; limite de novos (RF-002)']
    (usuario_id, cartao_id, dia_estudo) [unique, name: 'revisoes_primeira_do_dia', note: 'Parcial: where primeira_do_dia']
    cartao_id
    licao_id
    (id, usuario_id) [unique, name: 'revisoes_id_usuario', note: 'Alvo da FK composta de eventos_xp (DTEC 019). Criado pela spec 006']
  }

  Note: 'Evento imutável (RN-17). O estado antes e depois, a versão dos parâmetros e a semente permitem auditar e reproduzir o agendamento (RQ-004), alimentar o otimizador e implementar o desfazer futuro sem mudar o esquema.'
}

Table eventos_xp {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  revisao_id bigint [not null, note: 'Todo XP nasce de uma revisão; o bônus de domínio, da revisão que dominou o cartão']
  cartao_id bigint [note: 'Nulo se o cartão for excluído; o evento nunca é apagado']
  tipo tipo_evento_xp [not null]
  quantidade integer [not null, note: 'CHECK quantidade > 0; valor da regra versionada (DTEC 058)']
  versao_regra smallint [not null, note: 'Versão dos valores de XP (gamificacao/regras.py); a do limiar fica em revisoes.versao_regras']
  dia_estudo date [not null, note: 'Copiado da revisão']
  concedido_em timestamptz [not null, note: 'Instante da revisão (revisoes.revisada_em)']

  indexes {
    (revisao_id, tipo) [unique, name: 'eventos_xp_revisao_tipo', note: 'Um evento por fato; a unicidade por cartão e dia vem de revisoes_primeira_do_dia, e a do bônus, de cartoes.dominado_em (DTEC 059)']
    (usuario_id, dia_estudo)
    cartao_id [note: 'Cobre o SET NULL na exclusão do cartão']
  }

  Note: 'Histórico de XP, imutável e nunca removido, salvo na exclusão da conta (RN-18, RF-003 da 006). usuarios.xp_total é o seu total em cache.'
}

Table dias_estudo {
  usuario_id bigint [not null]
  dia date [not null]
  situacao situacao_dia [not null]
  fuso varchar(64) [not null, note: 'Fuso vigente no dia (CB-25)']
  cartoes_revisados integer [not null, default: 0, note: 'Cartões distintos revisados no dia (primeira_do_dia); reapresentações não contam (RN-21)']
  meta_diaria smallint [note: 'Meta vigente na última avaliação do dia; nula em dia liquidado sem atividade']
  meta_efetiva integer [note: 'min(meta diária, revisados + restantes) na última avaliação (RF-005); 0 no neutro; nula em nao_estudado sem atividade']
  meta_cumprida_em timestamptz [note: 'Presente se e somente se situacao = estudado']
  data_pulada boolean [not null, default: false, note: 'Data que nunca foi o dia corrente por mudança de fuso (D-003); só com neutro']
  liquidado_em timestamptz [note: 'Instante da liquidação; nulo em pendente e no estudado ainda corrente']

  indexes {
    (usuario_id, dia) [pk]
  }

  Note: '''
  Uma linha por estudante e data desde a primeira liquidação (spec 006, DTEC 061): o dia corrente com
  revisões (pendente ou estudado) e cada data liquidada (estudado, nao_estudado ou neutro). Linhas
  liquidadas nunca mudam de situação; estudado nunca volta atrás.
  CHECKs: estudado se e somente se meta_cumprida_em; estudado com cartoes_revisados >= 1;
  neutro com cartoes_revisados = 0; data_pulada só com neutro.
  '''
}

// ---------------------------------------------------------------------------
// Final acadêmico
// ---------------------------------------------------------------------------

TableGroup final_academico [color: #6B7280, note: 'Entram no final acadêmico (novembro de 2026)'] {
  indices_trechos
  conversas
  mensagens
  citacoes
  tokens_recuperacao_senha
}

Table indices_trechos {
  trecho_id bigint [pk, note: '1:1 com trechos']
  usuario_id bigint [not null, note: 'Filtro aplicado na própria consulta (RN-01)']
  materia_id bigint [not null]
  embedding "vector(1024)" [not null, note: 'bge-m3 (DTEC 008); índice HNSW com distância de cosseno']
  texto_busca tsvector [not null, note: 'to_tsvector(\'portuguese\', texto); índice GIN']
  modelo_embedding varchar(100) [not null]
  versao_modelo varchar(50) [not null]
  indexado_em timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, materia_id)
  }

  Note: 'Indexação para a busca híbrida (RF-06). Separada de trechos para que o MVP não carregue colunas que não usa.'
}

Table conversas {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  usuario_id bigint [not null]
  materia_id bigint [not null]
  cartao_id bigint [note: 'Preenchido no tira-dúvidas (F-16, EX-04)']
  titulo varchar(200)
  criado_em timestamptz [not null, default: `now()`]
  atualizado_em timestamptz [not null, default: `now()`]

  indexes {
    (materia_id, usuario_id)
  }
}

Table mensagens {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  conversa_id bigint [not null]
  papel papel_mensagem [not null]
  conteudo text [not null]
  sem_evidencia boolean [not null, default: false, note: 'O assistente declarou não ter encontrado a informação nas fontes']
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    (conversa_id, criado_em)
  }
}

Table citacoes {
  id bigint [pk, increment]
  mensagem_id bigint [not null]
  trecho_id bigint [note: 'Nulo depois que a fonte é excluída: exibe "fonte apagada"']
  ordem smallint [not null]
  fonte_titulo varchar(200) [not null, note: 'Cópia, como em evidencias_cartoes']
  pagina integer

  indexes {
    (mensagem_id, ordem) [unique]
    trecho_id
  }
}

Table tokens_recuperacao_senha {
  id bigint [pk, increment]
  usuario_id bigint [not null]
  token_hash bytea [not null, unique, note: 'SHA-256 do token enviado por e-mail']
  expira_em timestamptz [not null]
  usado_em timestamptz [note: 'Token de uso único']
  criado_em timestamptz [not null, default: `now()`]

  indexes {
    usuario_id
  }
}

// ---------------------------------------------------------------------------
// Relacionamentos
// ---------------------------------------------------------------------------

// Identidade
Ref: sessoes.usuario_id > usuarios.id [delete: cascade]
Ref: tokens_recuperacao_senha.usuario_id > usuarios.id [delete: cascade]

// Acervo. As FKs compostas garantem que fonte, geração, cartão e conversa
// pertencem ao mesmo estudante da matéria (RN-01).
Ref: materias.usuario_id > usuarios.id
Ref: fontes.(materia_id, usuario_id) > materias.(id, usuario_id) [delete: restrict]
Ref: trechos.fonte_id > fontes.id [delete: cascade]

// Cartões e IA
Ref: geracoes.(materia_id, usuario_id) > materias.(id, usuario_id) [delete: cascade]
// ON DELETE SET NULL (fonte_id): só a coluna da fonte é anulada (PostgreSQL 15+); garante mesma matéria e dono
Ref: geracoes.(fonte_id, materia_id, usuario_id) > fontes.(id, materia_id, usuario_id) [delete: set null]
Ref: geracoes_trechos.geracao_id > geracoes.id [delete: cascade]
Ref: geracoes_trechos.trecho_id > trechos.id [delete: cascade]
Ref: cartoes.(materia_id, usuario_id) > materias.(id, usuario_id) [delete: restrict]
Ref: cartoes.geracao_id > geracoes.id [delete: set null]
// Referência do cartão manual: restrict faz a exclusão da fonte falhar se o participante dos cartões
// não anular fonte_id antes (DTEC 027); fonte_id nulo desliga a verificação (MATCH SIMPLE)
Ref: cartoes.(fonte_id, materia_id, usuario_id) > fontes.(id, materia_id, usuario_id) [delete: restrict]
Ref: evidencias_cartoes.cartao_id > cartoes.id [delete: cascade]
Ref: evidencias_cartoes.trecho_id > trechos.id [delete: set null]
Ref: consumo_ia.usuario_id > usuarios.id
Ref: consumo_ia.geracao_id > geracoes.id [delete: set null]
Ref: cartoes_descartados.geracao_id > geracoes.id [delete: cascade]
Ref: cartoes_descartados.usuario_id > usuarios.id
Ref: ciencias_aviso_ia.usuario_id > usuarios.id

// Revisão e FSRS
Ref: parametros_fsrs.usuario_id > usuarios.id
Ref: licoes.usuario_id > usuarios.id
Ref: licoes_cartoes.(licao_id, usuario_id) > licoes.(id, usuario_id) [delete: cascade]
Ref: licoes_cartoes.(cartao_id, usuario_id) > cartoes.(id, usuario_id) [delete: cascade]
Ref: apresentacoes.(licao_id, usuario_id) > licoes.(id, usuario_id) [delete: cascade]
Ref: apresentacoes.(cartao_id, usuario_id) > cartoes.(id, usuario_id) [delete: cascade]
Ref: revisoes.usuario_id > usuarios.id
// Na migração: ON DELETE SET NULL (cartao_id), preservando usuario_id (PostgreSQL 15+)
Ref: revisoes.(cartao_id, usuario_id) > cartoes.(id, usuario_id) [delete: set null]
Ref: revisoes.(licao_id, usuario_id) > licoes.(id, usuario_id)
Ref: revisoes.parametros_fsrs_id > parametros_fsrs.id

// Gamificação
Ref: eventos_xp.usuario_id > usuarios.id
Ref: eventos_xp.(revisao_id, usuario_id) > revisoes.(id, usuario_id)
// Na migração: ON DELETE SET NULL (cartao_id), preservando usuario_id (PostgreSQL 15+)
Ref: eventos_xp.(cartao_id, usuario_id) > cartoes.(id, usuario_id) [delete: set null]
Ref: dias_estudo.usuario_id > usuarios.id

// Final acadêmico
// Em 1:1, o DBML cria a FK na tabela à direita
Ref: trechos.id - indices_trechos.trecho_id [delete: cascade]
Ref: conversas.(materia_id, usuario_id) > materias.(id, usuario_id) [delete: cascade]
Ref: conversas.cartao_id > cartoes.id [delete: set null]
Ref: mensagens.conversa_id > conversas.id [delete: cascade]
Ref: citacoes.mensagem_id > mensagens.id [delete: cascade]
Ref: citacoes.trecho_id > trechos.id [delete: set null]
