            "type": "string"
          },
          "mensagem": {
            "title": "Mensagem",
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "mensagem",
          "idRequisicao"
        ],
        "title": "Erro",
        "type": "object"
      },
      "ErroCampo": {
        "properties": {
          "campo": {
            "title": "Campo",
            "type": "string"
          },
          "mensagem": {
            "title": "Mensagem",
            "type": "string"
          }
        },
        "required": [
          "campo",
          "mensagem"
        ],
        "title": "ErroCampo",
        "type": "object"
      },
      "EstadoFonte": {
        "enum": [
          "pendente",
          "processando",
          "concluido",
          "falhou"
