{
  "components": {
    "schemas": {
      "CadastroEntrada": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "fuso": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "maxLength": 64,
            "title": "Fuso"
          },
          "nome": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Nome",
            "type": "string"
          },
          "senha": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Senha",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "title": "CadastroEntradaDTO",
        "type": "object"
      },
      "CodigoErro": {
        "description": "Códigos estáveis do contrato. As specs acrescentam; nunca renomeiam nem removem.",
        "enum": [
          "requisicao_malformada",
          "dados_invalidos",
          "email_em_uso",
          "credenciais_invalidas",
          "senha_atual_incorreta",
          "nao_autenticado",
          "csrf_invalido",
          "origem_nao_permitida",
          "recurso_nao_encontrado",
          "muitas_tentativas",
          "erro_interno",
          "materia_nome_em_uso",
          "cota_materias_excedida",
          "cota_fontes_excedida",
          "cota_armazenamento_excedida",
          "fonte_duplicada",
          "arquivo_muito_grande",
          "formato_nao_aceito",
          "tipo_divergente",
          "arquivo_vazio",
          "arquivo_corrompido",
          "pdf_protegido",
          "pdf_paginas_excedidas",
          "codificacao_invalida",
          "confirmacao_invalida",
          "impacto_alterado",
          "reprocessamento_indisponivel"
        ],
        "title": "CodigoErro",
        "type": "string"
      },
      "CodigoFalhaFonte": {
        "description": "Nome do contrato (`CodigoFalhaFonte`); no código, `CodigoFalha` basta.",
        "enum": [
          "falha_tecnica",
          "sem_texto",
          "conteudo_invalido"
        ],
        "title": "CodigoFalhaFonte",
        "type": "string"
      },
      "EntradaEntrada": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "senha": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Senha",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "senha"
        ],
        "title": "EntradaEntradaDTO",
        "type": "object"
      },
      "EnvioFonteEntrada": {
        "additionalProperties": false,
        "description": "Corpo *multipart* do envio: um arquivo e, opcionalmente, o título.\n\nFica aqui, e não em `dtos.py`, porque `UploadFile` é um tipo do FastAPI (a camada de DTOs\nnão importa o framework, DTEC 018): o formulário é um detalhe de transporte do controlador.",
        "properties": {
          "arquivo": {
            "contentMediaType": "application/octet-stream",
            "description": "Um único arquivo .pdf, .txt, .md ou .markdown",
            "format": "binary",
            "title": "Arquivo",
            "type": "string"
          },
          "titulo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "maxLength": 120,
            "minLength": 1,
            "title": "Titulo"
          }
        },
        "required": [
          "arquivo"
        ],
        "title": "EnvioFonteEntradaDTO",
        "type": "object"
      },
      "Erro": {
        "description": "Corpo único de erro do contrato (`Erro`).",
        "properties": {
          "campos": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErroCampo"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
