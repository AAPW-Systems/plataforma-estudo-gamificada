          },
          "materiaId": {
            "format": "uuid",
            "title": "Materiaid",
            "type": "string"
          },
          "mensagemFalha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mensagemfalha"
          },
          "nomeArquivo": {
            "title": "Nomearquivo",
            "type": "string"
          },
          "podeTentarNovamente": {
            "title": "Podetentarnovamente",
            "type": "boolean"
          },
          "processadaEm": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processadaem"
          },
          "tamanhoBytes": {
            "minimum": 1.0,
            "title": "Tamanhobytes",
            "type": "integer"
          },
          "tipoMidia": {
            "enum": [
              "application/pdf",
              "text/plain",
              "text/markdown"
