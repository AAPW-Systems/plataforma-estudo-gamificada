          "titulo": {
            "title": "Titulo",
            "type": "string"
          },
          "totalPaginas": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Totalpaginas"
          },
          "totalTrechos": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Totaltrechos"
          }
        },
        "required": [
          "id",
          "materiaId",
          "titulo",
          "nomeArquivo",
          "tipoMidia",
          "tamanhoBytes",
          "estado",
          "codigoFalha",
          "mensagemFalha",
          "podeTentarNovamente",
          "totalPaginas",
          "totalTrechos",
          "enviadaEm",
          "processadaEm"
