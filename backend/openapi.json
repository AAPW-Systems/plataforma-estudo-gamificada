        "properties": {
          "criadoEm": {
            "format": "date-time",
            "title": "Criadoem",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "fuso": {
            "title": "Fuso",
            "type": "string"
          },
          "limiteNovosDia": {
            "title": "Limitenovosdia",
