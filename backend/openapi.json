          "limiteNovosDia",
          "retencaoDesejada",
          "criadoEm"
        ],
        "title": "PerfilDTO",
        "type": "object"
      },
      "PerfilAlteracao": {
        "additionalProperties": false,
        "description": "Alteração parcial: só os campos enviados mudam (`model_fields_set`); ao menos um.\n\nO domínio impõe os limites (tudo ou nada, todos os erros de uma vez); aqui só se garante\no tipo: inteiros de verdade (sem `\"5\"`, `5.5` nem `true`) e número JSON finito para a retenção\n(sem `\"0.9\"`).",
        "properties": {
          "fuso": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "maxLength": 64,
            "title": "Fuso"
          },
          "limiteNovosDia": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Limitenovosdia"
          },
          "metaDiaria": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Metadiaria"
          },
          "nome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "maxLength": 100,
            "minLength": 1,
            "title": "Nome"
          },
          "retencaoDesejada": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "maximum": 0.97,
            "minimum": 0.7,
            "multipleOf": 0.01,
            "title": "Retencaodesejada"
          },
          "tamanhoLicao": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "maximum": 50.0,
            "minimum": 5.0,
            "title": "Tamanholicao"
          }
        },
        "title": "PerfilAlteracaoDTO",
        "type": "object"
      },
